# Copiá este archivo como .env (el .env NO se sube a GitHub).

DEBUG=1
# Generá una clave con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Desarrollo: el PostgreSQL del docker-compose.yml
DATABASE_URL=postgres://manzanitas:manzanitas@db:5432/manzanitas

# Producción con Neon (ejemplo, lo copiás del panel de Neon):
# DATABASE_URL=postgres://USUARIO:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/manzanitas?sslmode=require
# Producción con Supabase desde una red solo IPv4 (pooler en modo sesión, puerto 5432):
# DATABASE_URL=postgres://postgres.REF:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
